{
  "schemaVersion": 1,
  "id": "nimbus",
  "version": "${version}",
  "name": "Nimbus",
  "description": "A maintainable Minecraft Fabric client.",
  "authors": [
    "Limerence"
  ],
  "license": "LicenseRef-All-Rights-Reserved",
  "icon": "assets/nimbus/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "cc.nimbus.Nimbus"
    ]
  },
  "mixins": [
    {
      "config": "nimbus.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=${loader_version}",
    "fabric-api": ">=${fabric_version}",
    "minecraft": "${minecraft_version}",
    "java": ">=${java_version}"
  }
}
